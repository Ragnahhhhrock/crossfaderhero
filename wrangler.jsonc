{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crossfaderhero",
  "compatibility_date": "2026-10-01",
  // Only the Google tag gateway path and /api/* (cover art lookup, global stats) run the Worker; everything else is a static asset.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/k7q2m", "/k7q2m/*", "/api/*"]
  },
  // Global player stats: one Durable Object holds the totals (see worker/stats.js).
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "StatsCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsCounter"] }]
}
